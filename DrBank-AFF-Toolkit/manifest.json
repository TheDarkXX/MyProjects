{
  "manifest_version": 3,
  "name": "DrBank AFF Scout v2.6 — Shopee Category & Affiliate Signal Radar",
  "version": "2.6.0",
  "description": "Dual-Mode Lean Scout (สูตร 238 ล้าน): แถบข้าง Chrome Side Panel + กล่องลอย HUD, คำนวณจุดคุ้มทุนแอด 107฿/วัน, และยิงสินค้าเข้า Web UI Command Center",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_title": "DrBank AFF Scout — เปิดแถบข้าง Side Panel / Web UI",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://shopee.co.th/*",
    "https://affiliate.shopee.co.th/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*.doctorbankofficial.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.co.th/*",
        "https://affiliate.shopee.co.th/*"
      ],
      "css": [
        "src/styles/hud.css"
      ],
      "js": [
        "src/common/utils.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://shopee.co.th/*"
      ],
      "js": [
        "src/shopee-hud.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://affiliate.shopee.co.th/*"
      ],
      "js": [
        "src/shopee-affiliate.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
