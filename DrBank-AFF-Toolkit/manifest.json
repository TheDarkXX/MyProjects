{
  "manifest_version": 3,
  "name": "DRB Shopee Aff — Auto-Pull, Social Radar & Pool Bridge",
  "version": "2.15.0",
  "description": "DRB Shopee Aff v2.15.0: Auto-Pull ยอดคอม/คลิกเข้า aff.db อัตโนมัติ + Social Radar + V1 Realtime Scanner + Pool Bridge",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_title": "DRB Shopee Aff — เปิดแถบข้าง Side Panel / Web UI",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [
    "https://shopee.co.th/*",
    "https://*.shopee.co.th/*",
    "https://affiliate.shopee.co.th/*",
    "https://*.facebook.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*.doctorbankofficial.com/*",
    "https://*.doctorbankonline.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.co.th/*",
        "https://affiliate.shopee.co.th/*"
      ],
      "css": [
        "src/styles/hud.css"
      ],
      "js": [
        "src/common/utils.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://shopee.co.th/*"
      ],
      "js": [
        "src/shopee-hud.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://affiliate.shopee.co.th/*"
      ],
      "js": [
        "src/page-main-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://affiliate.shopee.co.th/*"
      ],
      "js": [
        "src/shopee-affiliate.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page-main-bridge.js"
      ],
      "matches": [
        "https://affiliate.shopee.co.th/*",
        "https://shopee.co.th/*"
      ]
    }
  ]
}
